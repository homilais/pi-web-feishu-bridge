# pi-web-feishu-bridge 环境变量（.env）
#
# 多机器人配置请用 config.yaml（运行 `pi-web-feishu-bridge --init` 生成模板）。
# 本文件主要用于：① 提供 PIWEB_PASSWORD 等供 config.yaml 中 ${PIWEB_PASSWORD} 插值；
# ② 作为无 config.yaml 时的单默认机器人回退配置（向后兼容）。
# 完整说明见 docs/REQUIREMENTS.md §9。

# ── Pi-Web 基座 ─────────────────────────────────────────────
# 必填：Basic Auth 密码（用户名固定为 pi）
PIWEB_PASSWORD=change-me

# 可选：Pi-Web 地址（默认 http://127.0.0.1:30141）
PIWEB_BASE_URL=http://127.0.0.1:30141

# 可选：新建 agent 时的默认模型（provider/modelId）
#   留空 = 用 pi 自身默认模型，之后用 /info 下拉或 /model 切换
DEFAULT_MODEL=

# ── 飞书应用（仅单默认机器人回退模式需要；多机器人请用 config.yaml）──
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx

# 可选：允许发消息的飞书 open_id（逗号分隔）；留空 = 允许所有单聊
LARK_ALLOW_OPEN_IDS=

# 可选：允许发消息的群 chat_id（oc_ 开头，逗号分隔）；留空 = 不限制（群内需 @机器人）
LARK_GROUP_ALLOWLIST=
