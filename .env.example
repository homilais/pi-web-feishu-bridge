# ── Pi-Web 基座 ─────────────────────────────────────────────
# 必填：Basic Auth 密码（用户名固定为 pi）
PIWEB_PASSWORD=change-me

# 可选：Pi-Web 地址（默认 http://127.0.0.1:30141）
PIWEB_BASE_URL=http://127.0.0.1:30141

# 可选：项目白名单（cwd 绝对路径，逗号分隔）
#   留空 = 不限，由 pi-web 的 /api/sessions 自动枚举所有项目
PROJECTS=

# 可选：新建 agent 时的默认模型（provider/modelId）
#   留空 = 用 pi 自身默认模型，之后用 /info 下拉或 /model 切换
DEFAULT_MODEL=

# ── 飞书应用 ─────────────────────────────────────────────────
# 企业自建应用（后台 → 凭证与基础信息）
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx

# 可选：允许发消息的飞书 open_id（逗号分隔）
#   留空 = 允许所有单聊
LARK_ALLOW_OPEN_IDS=

# 可选：允许发消息的群 chat_id（oc_ 开头，逗号分隔）
#   留空 = 不允许群聊（群内需 @机器人）
LARK_GROUP_ALLOWLIST=
